# PostgreSQL (Docker) — copy to .env and set real values locally
POSTGRES_DB=smart_attendance
POSTGRES_USER=smart_attendance_app
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_PORT=5432

# Connection URL for migrations (dbmate) and backend use
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=disable
DATABASE_URL=postgres://smart_attendance_app:change_me_in_local_env@localhost:5432/smart_attendance?sslmode=disable

# Backend API (Phase 2.3+)
BACKEND_PORT=3001
NODE_ENV=development

# Authentication (Phase 2.3 Step 2)
JWT_SECRET=replace_with_output_of_openssl_rand_-hex_32
JWT_EXPIRES_IN=8h

# Face recognition (Stage 5) — cosine similarity, 128-d face-api.js embeddings
# Minimum cosine similarity (0-1) for a match; tune against real faces.
FACE_MATCH_THRESHOLD=0.90
# Reject as ambiguous if the runner-up employee is within this similarity margin of the best.
FACE_AMBIGUITY_MARGIN=0.03
# Lifetime of the signed recognition proof returned by POST /face/recognize.
FACE_PROOF_TTL_SECONDS=30
